PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
LINE_CHANNEL_SECRET=
# ADMIN_API_KEY ใช้ป้องกัน Dashboard และ /api ทั้งหมด (Basic auth หรือ header x-admin-key)
ADMIN_API_KEY=change-this-before-production
# ลงเวลาด้วยการพิมพ์ในแชท false = ต้องลงเวลาผ่านหน้า LIFF ที่มีพิกัดเท่านั้น
ALLOW_CHAT_CHECKIN=false
