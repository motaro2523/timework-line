PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
LINE_CHANNEL_SECRET=
# ADMIN_API_KEY ใช้ป้องกัน Dashboard และ /api ทั้งหมด (Basic auth หรือ header x-admin-key)
ADMIN_API_KEY=change-this-before-production
# ลงเวลาด้วยการพิมพ์ในแชท false = ต้องลงเวลาผ่านหน้า LIFF ที่มีพิกัดเท่านั้น
ALLOW_CHAT_CHECKIN=false

# บัญชีผู้ดูแลระบบคนแรก ระบบสร้างให้ตอนเริ่มระบบถ้ายังไม่มีบัญชีนี้
# แล้วพิมพ์ลิงก์ตั้งรหัสผ่านลง log ดูด้วย docker compose logs api
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
# ใส่ LINE user id เพื่อให้ลิงก์ตั้งรหัสผ่านและการแจ้งเตือนส่งเข้า LINE ได้
ADMIN_BOOTSTRAP_LINE_USER_ID=
# ใช้ประกอบลิงก์ที่ส่งออกไป ต้องเป็นที่อยู่จริงของระบบ
PUBLIC_BASE_URL=https://timework.scriptbin.dev
